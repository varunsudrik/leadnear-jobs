{
  "name": "leadnear-jobs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev -p 4100",
    "build": "next build",
    "start": "next start -p 4100",
    "lint": "next lint",
    "db:schema": "docker run --rm -v \"$PWD\":/app -w /app python:3.12-slim sh -c 'pip install --quiet -r requirements.txt && python scripts/import_to_postgres.py --schema-only'",
