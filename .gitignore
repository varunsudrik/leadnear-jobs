# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — everything with real values stays out of git.
.env*
# ...except the template, which README.md tells you to copy. The bare `.env*`
# above would swallow it, leaving a fresh clone with nothing to copy from.
!.env.example

# local Python environment (scripts/import_to_postgres.py)
/.venv/
__pycache__/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# subagent-driven-development scratch (ledger, briefs, review packages)
.superpowers/

# skill vocabulary build and evaluation caches (scripts/build-skill-vocab.mjs)
/.cache/
