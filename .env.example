# Copy to .env.local and fill in. .env.local is gitignored (.gitignore: .env*).
# See README.md for what each block does and AGENTS.md for the sharp edges.

# ── Target database ──────────────────────────────────────────────────────────
# Two representations of the SAME database, because the toolchain is split:
#   DATABASE_URL  -> Next.js, the .mjs scripts, and Prisma
#   DB_*          -> scripts/import_to_postgres.py (psycopg wants discrete args)
# Keep them pointing at the same host.
DATABASE_URL=postgres://user:change-me@127.0.0.1:5432/jobboard

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=jobuser
DB_PASS=change-me
DB_NAME=jobboard

# "require" for a managed host (Aiven, RDS); "prefer" for a local PostgreSQL.
# Note libpq's "require" encrypts without verifying the chain. For a verified
# chain use "verify-full" together with DB_SSL_ROOT_CERT / DB_SSL_CA.
DB_SSLMODE=prefer

# Total connections shared by the app, Prisma and every script. Small managed
# plans cap the server at 20; raise this only with real headroom.
DB_POOL_MAX=5

# ── Seed source ──────────────────────────────────────────────────────────────
# Database to copy sample jobs FROM. Used only by scripts/seed-from-prod.mjs,
# which opens it with default_transaction_read_only=on so the server itself
# refuses writes. The application never reads this. Leave blank to skip seeding.
PROD_DATABASE_URL=
SEED_JOB_LIMIT=5000

# ── Application ──────────────────────────────────────────────────────────────
# Must include /jobs — next.config.mjs mounts this app at that base path.
PUBLIC_BASE_URL=http://localhost:4100/jobs
REVALIDATE_SECRET=replace-with-a-long-random-secret

# HTTP Basic auth for /admin and /backoffice (middleware.js).
# Leaving these EMPTY makes those routes 401, which is the safe default.
ADMIN_USER=
ADMIN_PASSWORD=

# ── Authentication (NextAuth v4, credentials provider) ───────────────────────
# Must be the full path to the NextAuth API root, including the basePath.
# Setting this to the site root (…/jobs) makes NextAuth advertise the wrong
# callback URLs and sends failed sign-ins to a route that does not exist.
NEXTAUTH_URL=http://localhost:4100/jobs/api/auth
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# ── Optional ─────────────────────────────────────────────────────────────────
# Unset: AdSense renders nothing (app/[slug]/page.jsx).
NEXT_PUBLIC_GOOGLE_ADS_CLIENT_ID=

# Unset: /api/contact and /api/opt-out return 503 with a clear message instead
# of failing silently. SMTP_* are accepted as alternatives to BREVO_SMTP_*.
BREVO_SMTP_HOST=
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASS=
MAIL_FROM=
MAIL_TO=

# Unset: the footer's blog link falls back to https://blog.leadnear.com
NEXT_PUBLIC_BLOG_URL=

# ── Publisher tuning ─────────────────────────────────────────────────────────
PUBLISH_BATCH_SIZE=400
PUBLISH_MAX_JOBS=10000
PUBLISH_CONCURRENCY=8
WARM_NEWEST_LIMIT=5000
