    "db:push": "node scripts/prisma.mjs db push",
    "db:studio": "node scripts/prisma.mjs studio",
    "db:seed": "node scripts/seed-from-prod.mjs",
    "db:verify": "node scripts/verify-db.mjs",
    "resume-tables:migrate": "node scripts/migrate-resume-tables.mjs",
    "publish:jobs": "node scripts/publish-jobs.mjs",
    "refresh:counts": "node scripts/publish-jobs.mjs refresh-counts",
    "warm:newest": "node scripts/publish-jobs.mjs warm-newest",
    "cache-handler:test": "node scripts/test-cache-handler.mjs",
    "autocomplete:test": "node scripts/test-autocomplete.mjs",
    "live-count:test": "node scripts/test-live-count.mjs",
    "job-slug:test": "node scripts/test-job-slug.mjs",
    "job-slug:backfill": "node scripts/backfill-job-slugs.mjs",
    "design-tokens:test": "node scripts/test-design-tokens.mjs",
    "home-spec:test": "node scripts/test-home-spec.mjs",
    "format:test": "node scripts/test-format.mjs",
    "ai:test": "node scripts/test-openrouter.mjs",
    "resume-parse:test": "node scripts/test-resume-parse.mjs",
    "format-checks:test": "node scripts/test-format-checks.mjs",
    "resume-extract:test": "node scripts/test-resume-extract.mjs",
    "resume-score:test": "node scripts/test-resume-score.mjs",
    "resume-store:test": "node scripts/test-resume-store.mjs",
    "resume-eval:test": "node scripts/test-resume-eval.mjs",
    "match:test": "node scripts/test-resume-match.mjs",
    "skills-sections:test": "node scripts/test-skills-sections.mjs"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "lucide-react": "^0.485.0",
    "next": "15.5.21",
    "next-auth": "^4.24.15",
    "nodemailer": "^9.0.3",
    "pg": "^8.16.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.5",
    "eslint": "^8",
    "eslint-config-next": "15.5.21",
    "postcss": "8.5.23",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7"
  },
  "overrides": {
    "sharp": "0.35.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
