datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // shadowDatabaseUrl = env("SHADOW_DATABASE_URL") // Only needed when using a cloud provider that doesn't support the creation of new databases, like Heroku. Learn more: https://pris.ly/migrate-shadow
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id              String           @id @default(cuid())
  name            String?
  email           String?          @unique
  emailVerified   DateTime?
  image           String?
  password        String?
  phone           String?
  phoneVerified   Boolean          @default(false)
  token           String?
  credits         Decimal          @default(0.0)
  isAdmin         Boolean          @default(false)
  role            String?          @default("user")
  referral_code   String?
  referrer        String?
  unique_count    Int?             @default(0)
  created_ip      String?
  last_login_ip   String?
  last_login_date DateTime         @default(now())
  planActive      Boolean          @default(false)
  apiAccess       Boolean          @default(false)
  allowPurchase   Boolean          @default(false)
  isBlocked       Boolean          @default(false)
  allowLeadSearch Boolean          @default(false)
  created_at      DateTime         @default(now())
  accounts        Account[]
  sessions        Session[]
  linkedinData    LinkedinData[]
  verifyuserdata  Verifyuserdata[]
  uploadeddata    Uploadeddata[]

  supportUsers      Supportusers[]
  tickets           Tickets[]
  ticket_comments   Ticket_comments[]
  Orders            Orders[]
  Purchased         Purchased[]
  Report            Report[]
  Customlist        Customlist[]
  Invaliddata       Invaliddata[]
  Ratelimit         Ratelimit[]
  ContactLookup     ContactLookup[]
  DailySearchLimit  DailySearchLimit[]
  SearchFilter      SearchFilter[]
  ExportRequests    ExportRequests[]
  ApiRequests       ApiRequests[]
  AdminLoginLogs    AdminLoginLogs[]
  ExtensionTracking ExtensionTracking[]
  PricingClickLogs  PricingClickLog[]
}

model Ratelimit {
  id          String    @id @default(cuid())
  userId      String
  mailCount   Int       @default(0)
  otpCount    Int       @default(0)
  mailExpires DateTime?
  otpExpires  DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model LinkedinData {
  id           String @id @default(cuid())
  full_name    String
  linkedin_url String @unique
  email        String
  phone_number String
  userId       String
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verifyuserdata {
  id           String   @id @default(cuid())
  full_name    String
  linkedin_url String   @unique
  email        String
  phone_number String
  userId       String
  isVerified   Boolean
  reason       String
  country      String   @default("INDIA")
  isInvalid    Boolean  @default(false)
  date         DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Purchased  Purchased[]
  // Report     Report[]
  // Customlist Customlist[]

  @@index([country])
}

model Uploadeddata {
  id             String       @id @default(cuid())
  full_name      String
  linkedin_url   String
  email          String
  emailAvailable Boolean      @default(false)
  phone_number   String
  phoneAvailable Boolean      @default(false)
  userId         String
  isVerified     Boolean
  country        String
  status         Uploadstatus @default(NEW)
  reason         String?
  date           DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  Customlist Customlist[]
}

model Invaliddata {
  id           Int      @id @default(autoincrement())
  linkedinId   String
  full_name    String
  linkedin_url String   @default("")
  email        String
  phone_number String
  country      String
  userId       String
  reason       String?
  isInvalid    Boolean  @default(false)
  date         DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Uploadstatus {
  NEW
  DELETE
  VERIFIED
}

model Pricecredits {
  id      Int     @id @default(autoincrement())
  price   Decimal @default(0.0)
  credits Decimal @default(0.0)
}

model Supportusers {
  id     Int    @id @default(autoincrement())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Tickets {
  id              String            @id @default(cuid())
  title           String
  msg             String
  userId          String
  created         DateTime          @default(now())
  status          Status            @default(OPEN)
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticket_comments Ticket_comments[]
}

enum Status {
  OPEN
  CLOSE
  RESOLVED
}

model Ticket_comments {
  id       String   @id @default(cuid())
  msg      String   @db.Text
  ticketId String
  userId   String
  is_read  Boolean  @default(false)
  created  DateTime @default(now())
  tickets  Tickets  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Blogs {
  id         Int      @id @default(autoincrement())
  author     String
  title      String
  slug       String   @unique
  views      Int
  image      String
  body       String?  @db.Text
  published  Boolean
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Orders {
  id         Int       @id @default(autoincrement())
  amount     Decimal
  credits    Decimal
  currency   Currency  @default(INR)
  orderId    String
  userId     String
  invoiceUrl String    @default("")
  type       OrderType @default(PAID)
  planType   String    @default("Default")
  expiryDate DateTime  @default(now())
  created_at DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Currency {
  INR
  USD
}

enum OrderType {
  FREE
  PAID
  ADMIN
}

model Purchased {
  id            Int           @id @default(autoincrement())
  userId        String
  liId          String
  credits_taken Decimal
  status        Liststatus    @default(PURCHASED)
  type          PurchaseType?
  reason        String?
  updated_by    String?
  created_at    DateTime      @default(now())
  updatedAt     DateTime?     @updatedAt
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Customlist    Customlist[]
  // verifyuserdata Verifyuserdata @relation(fields: [liId], references: [id], onDelete: Cascade)

  @@unique([liId, userId])
}

enum SnapshotResolutionStatus {
  RESOLVED
  UNRESOLVED
  UNAVAILABLE
}

model PurchasedContactSnapshot {
  liId              String                   @id @db.VarChar(191)
  linkedin_url      String                   @db.VarChar(500)
  full_name         String?                  @db.VarChar(191)
  email             String?                  @db.Text
  phone_number      String?                  @db.Text
  country           String?                  @db.VarChar(191)
  industry          String?                  @db.VarChar(191)
  job_title         String?                  @db.VarChar(191)
  job_title_role    String?                  @db.VarChar(191)
  job_company_name  String?                  @db.VarChar(191)
  location_region   String?                  @db.VarChar(191)
  location_name     String?                  @db.VarChar(191)
  location_locality String?                  @db.VarChar(191)
  resolution_status SnapshotResolutionStatus @default(UNRESOLVED)
  resolution_source String?                  @db.VarChar(32)
  created_at        DateTime                 @default(now()) @db.Timestamp(3)
  updated_at        DateTime                 @updatedAt @db.Timestamp(3)

  @@index([resolution_status])
  @@map("PurchasedContactSnapshot")
}

enum PurchaseType {
  API
  SEARCH
  LOOKUP
}

enum Liststatus {
  PURCHASED
  REPORT
  REFUND
  REJECT
}

model Report {
  id         Int      @id @default(autoincrement())
  userId     String
  liId       String
  reason     String
  created_at DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // verifyuserdata Verifyuserdata @relation(fields: [liId], references: [id], onDelete: Cascade)
}

model Customlist {
  id                Int           @id @default(autoincrement())
  userId            String
  linkedinId        String?
  linkedinUrl       String
  listId            String
  listName          String?
  full_name         String?
  country           String?
  industry          String?
  job_title         String?
  job_title_role    String?
  job_company_name  String?
  location_region   String?
  location_name     String?
  location_locality String?
  email             String?
  phone             String?
  created_at        DateTime      @default(now())
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  Uploadeddata      Uploadeddata? @relation(fields: [uploadeddataId], references: [id])
  uploadeddataId    String?
  // verifyuserdata Verifyuserdata? @relation(fields: [linkedinId], references: [id], onDelete: Cascade)
}

model GeneratedEmails {
  id            Int      @id @default(autoincrement())
  full_name     String
  linkedinUrl   String   @unique
  valid_email   String
  invalid_email String
  status        String
  updated_at    DateTime @updatedAt
}

model WhatsappChecks {
  phone      String   @id @unique
  success    Boolean
  updated_at DateTime @updatedAt
}

model ContactLookup {
  id               String     @id @default(cuid())
  listId           String
  userId           String
  full_name        String?
  linkedin_url     String
  email            String?
  phone_number     String?
  country          String     @default("India")
  industry         String?
  job_title        String?
  job_company_name String?
  location_name    String?
  status           String
  reason           String?
  credits_taken    Decimal?
  updated_by       String?
  mail_type        PFMailType @default(PREMIUMFINDER)
  mail_sent        Boolean    @default(false)
  created_at       DateTime   @default(now())
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum PFMailType {
  PREMIUMFINDER
  PURCHASED
}

model DeletedLinkedin {
  id                String @id
  full_name         String
  linkedin_url      String
  email             String
  phone_number      String
  country           String
  industry          String
  job_title         String
  job_title_role    String
  job_company_name  String
  location_region   String
  location_name     String
  location_locality String
}

model CompanyDetails {
  id           Int      @id @default(autoincrement())
  os_company   String
  company      String
  industry     String   @unique
  headquarters String
  website      String
  twitter      String
  facebook     String
  linkedin     String
  no_employees String
  founded      String
  revenue      String
  faq          String
  updated_at   DateTime @updatedAt
}

model DashboardRecords {
  id                String @id
  full_name         String
  linkedin_url      String
  email             String
  phone_number      String
  country           String
  industry          String
  job_title         String
  job_title_role    String
  job_company_name  String
  location_region   String
  location_name     String
  location_locality String
}

model DomainStatus {
  id      Int     @id @default(autoincrement())
  domain  String  @unique
  blocked Boolean @default(false)
}

model DailySearchLimit {
  id         String   @id @default(cuid())
  userId     String   @unique
  count      Int      @default(0)
  updated_at DateTime
  created_at DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ExtensionRecords {
  id                String   @id
  full_name         String?
  linkedin_url      String   @unique
  country           String?
  industry          String?
  job_title         String?
  job_title_role    String?
  job_company_name  String?
  location_region   String?
  location_name     String?
  location_locality String?
  email             String?
  phone             String?
  updateStatus      String?  @default("Waiting")
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
}

model PricingPlans {
  id        Int    @id @default(autoincrement())
  plan_type String
  credits   Int
  inr_price Int
  usd_price Int
}

model SearchFilter {
  id          Int     @id @default(autoincrement())
  userId      String
  linkedin_id String
  is_viewed   Boolean
  is_hidden   Boolean
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, linkedin_id])
}

model CreditReference {
  id     Int    @id @default(autoincrement())
  type   String
  credit Float
}

model ExportRequests {
  id             Int          @id @default(autoincrement())
  userId         String
  start_date     DateTime
  end_date       DateTime
  size           Int
  download_url   String?
  updated_by     String?
  download_count Int          @default(0)
  status         ExportStatus @default(INITIATED)
  updated_at     DateTime     @updatedAt
  created_at     DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ExportStatus {
  INITIATED
  APPROVED
  REJECTED
}

model SeoRequests {
  id         Int       @id @default(autoincrement())
  url        String
  status     SeoStatus @default(INITIATED)
  message    String?
  updated_at DateTime  @updatedAt
  created_at DateTime  @default(now())
}

enum SeoStatus {
  INITIATED
  SUBMITTED
  REJECTED
}

model ApiRequests {
  id         Int       @id @default(autoincrement())
  userId     String
  linkedin   String?
  email      String?
  credits    Float?
  status     ApiStatus @default(SUCCESS)
  count      Int
  updated_at DateTime  @updatedAt
  created_at DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, linkedin, email])
}

enum ApiStatus {
  SUCCESS
  FAILURE
}

model EnquiryCompany {
  id         Int      @id @default(autoincrement())
  email      String
  url        String?
  created_ip String?
  count      Int      @default(0)
  updated_at DateTime @updatedAt
  created_at DateTime @default(now())

  @@unique([email, url])
}

model AuditCredits {
  id         Int      @id @default(autoincrement())
  userId     String
  credits    Float
  updated_at DateTime @updatedAt
  created_at DateTime @default(now())
}

model DashboardSearchLogs {
  id           Int      @id @default(autoincrement())
  userId       String
  name         String?
  industry     String?
  job          String?
  company      String?
  location     String?
  locationType String?
  pageNo       Int?
  checkPhone   Boolean?
  linkedinUrls String?
  emails       String?
  updated_at   DateTime @updatedAt
  created_at   DateTime @default(now())
}

model AdminLoginLogs {
  id            String   @id @default(cuid())
  userId        String
  email         String
  name          String?
  ipAddress     String
  userAgent     String
  device        String
  browser       String
  os            String
  isBot         Boolean  @default(false)
  loginMethod   String // 'credentials', 'google', 'linkedin', 'token'
  success       Boolean
  failureReason String?
  location      String? // Can be populated with geolocation data if needed
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([ipAddress])
}

model ExtensionTracking {
  id                 String   @id @default(cuid())
  userId             String
  extensionInstalled Boolean  @default(false)
  lastUsed           DateTime @default(now())
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
}

model PricingClickLog {
  id             String   @id @default(cuid())
  userId         String
  email          String
  ipAddress      String
  currency       Currency
  paymentGateway String?
  userType       String?
  paymentIntent  String?
  planType       String?
  planName       String?
  planPrice      String?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([createdAt])
  @@index([currency])
  @@index([paymentGateway])
}
