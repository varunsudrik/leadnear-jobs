# next-auth@4 declares `peerOptional nodemailer@^7`, while this project uses
# nodemailer@9 directly for the contact and opt-out forms. next-auth only touches
# nodemailer for its Email provider, which this app does not configure (it is
# credentials-only, see lib/auth-options.js), so the conflict is inert.
#
# Required for CI and Vercel specifically: they run a plain `npm install`, which
# fails the resolution outright rather than warning. leadnear-main pairs the same
# two versions.
legacy-peer-deps=true
